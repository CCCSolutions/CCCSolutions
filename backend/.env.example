# For the Supabase CLI (supabase start), NOT the Worker. Copy to backend/.env.
# Holds env() values referenced in supabase/config.toml. Gitignored, never commit.
#
# Before first `supabase start`, also generate a local signing key:
#   supabase gen signing-key --algorithm ES256   (save the output as a JSON array in supabase/signing_keys.json)

SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
