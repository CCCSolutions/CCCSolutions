{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cccsolutions-frontend",
  "main": ".open-next/worker.js",
  // Matches backend/wrangler.jsonc. nodejs_compat needs 2024-09-23 or later.
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // No production *.workers.dev URL — the site is served from its own domain.
  // preview_urls defaults to workers_dev, so it must be set explicitly or every
  // deploy resets the dashboard's Preview toggle back off (which is why Git
  // deployments reported success with no Preview URL).
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Lets the worker call itself; required by OpenNext for ISR revalidation.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cccsolutions-frontend",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
