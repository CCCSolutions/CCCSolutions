# Frontend environment variables — copy to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Supabase project URL and anon (public) key.
# Both are safe to expose to the browser (anon key has no elevated privileges;
# all sensitive operations go through the Hono Worker with the service-role key).
# Found in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hono API base URL (no trailing slash)
# Local dev: http://localhost:8787
# Production: https://api.cccsolutions.ca  (or whatever your worker domain is)
NEXT_PUBLIC_API_URL=http://localhost:8787
